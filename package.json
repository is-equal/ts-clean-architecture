{
  "name": "clean-architecture",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint **/*.{ts,tsx}",
    "format": "yarn lint --fix",
    "prebuild": "rm -rf build",
    "build": "tsc -p tsconfig.build.json",
    "start": "TZ=UTC node build/api/main.js",
    "start:watch": "TZ=UTC nodemon -w build build/api/main.js",
    "start:nest": "TZ=UTC node build/nest/main.js",
    "start:watch:nest": "TZ=UTC nodemon -w build build/nest/main.js",
    "prebuild:app": "rm -rf build",
    "build:app": "webpack --mode production --config src/ui/webpack.config.js",
    "start:app": "webpack-dev-server --config src/ui/webpack.config.js",
    "test": "TZ=UTC jest",
    "coverage": "TZ=UTC jest --coverage",
    "migration:create": "typeorm migration:create",
    "migration:run": "typeorm migration:run",
    "migration:revert": "typeorm migration:revert",
    "migration:generate": "typeorm migration:generate"
  },
  "dependencies": {
    "@nestjs/common": "^7.1.1",
    "@nestjs/core": "^7.1.1",
    "@nestjs/platform-express": "^7.1.1",
    "eslint-config-react-app": "^5.2.1",
    "fast-xml-parser": "^3.16.0",
    "fastify": "^2.14.1",
    "jsonwebtoken": "^8.5.1",
    "nodemon": "^2.0.4",
    "pg": "^8.2.1",
    "pino-pretty": "^4.0.0",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/jest": "^25.2.2",
    "@types/jsonwebtoken": "^8.5.0",
    "@types/node": "^14.0.1",
    "@types/react": "^16.9.35",
    "@types/react-dom": "^16.9.8",
    "@typescript-eslint/eslint-plugin": "^3.0.2",
    "@typescript-eslint/parser": "^3.0.1",
    "babel-eslint": "^10.1.0",
    "eslint": "^6.8.0",
    "eslint-config-equal": "link:./eslint-config-equal",
    "eslint-plugin-flowtype": "^5.1.3",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-react": "^7.20.0",
    "eslint-plugin-react-hooks": "^4.0.4",
    "eslint-plugin-standard": "^4.0.1",
    "html-webpack-plugin": "^4.3.0",
    "jest": "^25.5.4",
    "react": "^16.13.1",
    "react-dom": "^16.13.1",
    "source-map-loader": "^1.0.0",
    "ts-jest": "^25.5.1",
    "ts-loader": "^7.0.5",
    "typeorm": "^0.3.31",
    "typescript": "^3.9.2",
    "webpack": "^4.43.0",
    "webpack-bundle-analyzer": "^3.8.0",
    "webpack-cli": "^3.3.11",
    "webpack-dev-server": "^3.11.0"
  }
}
