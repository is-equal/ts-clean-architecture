{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node",
    "outDir": "build"
  },
  "files": [
    "src/core/core-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    ".jest-cache"
  ],
  "include": [
    "src/**/*.ts"
  ]
}
