{
  "compilerOptions": {
    "target": "ES2019",
    "module": "CommonJS",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node",
    "outDir": "build",
    "jsx": "react",
  },
  "files": [
    "src/core/core-env.d.ts"
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
  ]
}
